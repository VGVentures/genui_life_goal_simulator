# API keys for the model benchmark harness.
#
# Copy this file to `benchmark/keys.env` (gitignored) and fill in the keys for
# the providers you want to benchmark. It is passed to the benchmark with
# `--dart-define-from-file=benchmark/keys.env`. Any model whose key is empty is
# skipped automatically.
#
# Every model runs through a direct provider API (pure Dart HTTP), so no
# Firebase or browser is involved — Gemini included.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
INCEPTION_API_KEY=
